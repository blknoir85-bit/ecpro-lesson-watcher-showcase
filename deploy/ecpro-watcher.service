[Unit]
Description=EC Pro Lesson Availability Watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ecpro-lesson-watcher
ExecStart=/home/ubuntu/ecpro-lesson-watcher/.venv/bin/python -u /home/ubuntu/ecpro-lesson-watcher/watcher.py --loop 900
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
